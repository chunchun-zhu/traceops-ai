SUZHANG_DB_PATH=data/suzhang.db
# Leave empty for the clearly labelled rule demonstration mode.
SUZHANG_LLM_BASE_URL=
SUZHANG_LLM_MODEL=Qwen3-32B
SUZHANG_LLM_API_KEY=
# OpenAI compatible /embeddings endpoint, e.g. http://localhost:8001/v1
SUZHANG_EMBEDDING_BASE_URL=
SUZHANG_EMBEDDING_MODEL=BGE-M3
SUZHANG_EMBEDDING_API_KEY=
# Optional full HTTP endpoint. Request: {query, documents}.
# Response: {scores: [...]} or {results: [{index, relevance_score}]}.
SUZHANG_RERANK_URL=
SUZHANG_RERANK_API_KEY=
SUZHANG_MODEL_TIMEOUT=20
SUZHANG_SEED_DEMO=true
# Local demo is unauthenticated. Set a token before exposing the service.
SUZHANG_API_TOKEN=
# accounts enables named identities, roles, independent standard approval.
# Bootstrap first admin with scripts/accounts.py before starting.
SUZHANG_AUTH_MODE=legacy
# Keep true under HTTPS. Set false only for local http development.
SUZHANG_COOKIE_SECURE=true
